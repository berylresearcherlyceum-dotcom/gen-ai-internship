## PART B — Gradient Descent (Core Task)
### Task 3: Gradient Descent from Scratch

# Training data
x = [1, 2, 3, 4, 5]
y_true = [3, 4, 5, 6, 7]  # assume y = x + 2

# Initialize parameters
w = 0.0
b = 0.0

learning_rate = 0.01
epochs = 10

def mse(y_true, y_pred):
    total_error = 0
    for yt, yp in zip(y_true, y_pred):
        total_error += (yt - yp) ** 2
    return total_error / len(y_true)

n = len(x)

for epoch in range(epochs):
    y_pred = []
    
    # Forward pass
    for xi in x:
        y_pred.append(w * xi + b)
    
    # Compute loss
    loss = mse(y_true, y_pred)
    
    # Gradients
    dw = 0
    db = 0
    for xi, yt, yp in zip(x, y_true, y_pred):
        dw += -2 * xi * (yt - yp)
        db += -2 * (yt - yp)
    
    dw = dw / n
    db = db / n
    
    # Update parameters
    w = w - learning_rate * dw
    b = b - learning_rate * db
    
    # Tracking values
    print(f"Epoch {epoch+1}: Loss={loss:.4f}, w={w:.4f}, b={b:.4f}")

