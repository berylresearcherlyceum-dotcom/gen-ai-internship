## PART A — Math Warm-Up
### Task 1: Mean Squared Error (MSE)
def mse(y_true, y_pred):
    """
    Compute Mean Squared Error
    """
    n = len(y_true)
    return sum((yt - yp) ** 2 for yt, yp in zip(y_true, y_pred)) / n


y_true = [2, 4, 6, 8]
y_pred = [1.5, 3.5, 6.5, 7.5]

print("MSE:", mse(y_true, y_pred))
