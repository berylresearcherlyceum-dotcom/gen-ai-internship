    "# -------- Mini Logic Check --------\n",
    "def normalize(data):\n",
    "    min_val = min(data)\n",
    "    max_val = max(data)\n",
    "    return [(x - min_val) / (max_val - min_val) for x in data]\n",
    "\n",
    "print(\"\\nNormalized values:\", normalize([10, 20, 30, 40]))\n"
   ]
